#!/bin/bash 

# otree sys conf
source "$HOME/.oTree/venv/bin/activate"
source "$HOME/otree_environ_config"

################
# DESKTOP link
################
function xdisplay {
killall otree
killall daphne
zenity --question --title="collectstatic" --text="Are you running this experiment for the first time in this environment\nor did you add any statics\n\n  - images, stylesheets, scripts, etc.- \n\nsince you last ran it here?"
case $? in
0) (cd "$HOME/.oTree";otree collectstatic --noinput)
;;
esac

tstamp=$(date +%Y%m%d-%T)
zenity --title="Reset DataBase" --question --text="Do you require a <b>database</b> reset?"
case $? in
0)      echo -e "\e[31 Creating backup of current database!\e[0m"
	pg_dump $DB_NAME | 7za a -si "$HOME/DB_BackUps/pg_$tstamp.7z"
	(cd "$HOME/.oTree";otree resetdb --noinput && otree runprodserver)
;;
1) (cd "$HOME/.oTree";otree runprodserver --port=$DAPHNE_PORT)
;;
esac

}

###############################
# CONSOLE
###############################
function ttydisplay () {
killall otree
killall daphne

if [ $# -eq 0 ]
then
	read -p "Do you require 'collectstatic' to run? [y/N]: " YN
	case $YN in
	[yY]* ) (cd "$HOME/.oTree";otree collectstatic --noinput)
	;;
	esac

	tstamp=$(date +%Y%m%d-%T)
	read -p "Do you require a DATABASE RESET ? [y/N]: " YN
	case $YN in
	[yY]* )      echo -e "Creating backup of current database!"
		pg_dump $DB_NAME | 7za a -si "$HOME/DB_BackUps/pg_$tstamp.7z"
		(cd "$HOME/.oTree";otree resetdb --noinput)
	;;
	esac
else
	for arg in "$@"
	do
		case $arg in
		"-c" )  (cd "$HOME/.oTree";otree collectstatic --noinput)
		;;
		"-h" ) printf"
		otree_restart [OPTIONS]
		-c	collectstatic
		-m	send mails on crash to account defined in otree_environ_config
		-r	resetdb
		-h	help
		"
		;;
		"-m" )  MAIL=1
		;;
		"-r" )  echo -e "Creating backup of current database!"
			pg_dump otree_admin | 7za a -si "$HOME/DB_BackUps/pg_$tstamp.7z"
			(cd "$HOME/.oTree";otree resetdb --noinput)
		;;
		esac
	done
fi

if [ $MAIL -eq 1 ]
then
	printf "Will send email on otree stop."
	(cd "$HOME/.oTree";otree runprodserver --port=$DAPHNE_PORT) && 
	echo "otree has stopped."
	mail -s "server has stopped" $USER_EMAIL <<< "Warning!!! The experiment on server port $DAPHNE_PORT has stopped."
else
	
	(cd "$HOME/.oTree";otree runprodserver --port=$DAPHNE_PORT)
fi
}




case $1 in
"-x" ) xdisplay;;
* ) ttydisplay;;
esac


